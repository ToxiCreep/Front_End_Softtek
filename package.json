{
  "name": "softtek-sucursal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev:api\" \"npm run dev:web\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "api:types": "openapi-typescript contracts/openapi.json -o src/api-schema.d.ts",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx --watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "check:portable": "tsc -p vendor/maya-portable/tsconfig.check.json --noEmit",
    "build:portable": "tsc -p vendor/maya-portable/tsconfig.json",
    "build:demo": "npm --prefix vendor/maya-portable run build:demo"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "express": "^4.22.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.2",
    "msw": "^2.12.0",
    "openapi-typescript": "^7.10.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
