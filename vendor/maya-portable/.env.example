# Mismos modelos del proyecto original; cambia el nombre por uno disponible en tu cuenta.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
A2UI_MODEL=gemma4:31b
A2UI_TEMPERATURE=0.5
# Opcional: respaldo o proveedor principal si no configuras Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Para Ollama local: OLLAMA_HOST=http://localhost:11434 y OLLAMA_MODEL=<modelo instalado>.
PORT=3002
# Archivo UTF-8 con el contexto/reglas del NUEVO programa (opcional).
MAYA_CONTEXT_FILE=
