VITE_API_BASE_URL=/api/v1
VITE_USE_MOCKS=true
# URL del backend del equipo, incluyendo /api/v1. Se usa con VITE_USE_MOCKS=false.
SOFTTEK_API_URL=http://localhost:8080/api/v1
SOFTY_PORT=3001
SOFTY_BIND=127.0.0.1
# Ollama Cloud: usa una cuenta Free con cuota disponible. La clave es privada del servidor.
# No compres créditos ni actives recargas si quieres mantener el gasto en cero.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
A2UI_MODEL=gemma4:31b
