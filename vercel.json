{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/softy.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/softy/:path*", "destination": "/api/softy" },
    { "source": "/api/v1/:path*", "destination": "https://tienda-inteligente-api.onrender.com/api/v1/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
